diff --git a/src/word.js b/src/word.js
index 14e3674..cfd0c16 100644
--- a/src/word.js
+++ b/src/word.js
@@ -1,8 +1,15 @@
 'use strict';
 
 // Selection/word logic lives in this module.
+const MAX_CJK_WORD_LENGTH = 8;
+
+const LATIN_WORD = /^[A-Za-z][A-Za-z'-]*$/;
+const CJK_RUN = /^[\p{Script=Han}\p{Script=Hangul}\p{Script=Hiragana}\p{Script=Katakana}ー]+$/u;
+
 function isSingleWord(text) {
-  return /^[A-Za-z][A-Za-z'-]*$/.test(text);
+  if (LATIN_WORD.test(text)) return true;
+  if ([...text].length > MAX_CJK_WORD_LENGTH) return false;
+  return CJK_RUN.test(text);
 }
 
-module.exports = { isSingleWord };
+module.exports = { isSingleWord, MAX_CJK_WORD_LENGTH };
