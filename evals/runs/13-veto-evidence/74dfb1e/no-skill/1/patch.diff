diff --git a/src/word.js b/src/word.js
index 14e3674..a05ccf3 100644
--- a/src/word.js
+++ b/src/word.js
@@ -1,8 +1,29 @@
 'use strict';
 
 // Selection/word logic lives in this module.
+//
+// Lookup policy by script:
+// - Latin: existing ASCII heuristic, unchanged.
+// - Korean (Hangul): orthography uses spaces between words, so a
+//   whitespace-free Hangul run is a single word, like Latin.
+// - Chinese/Japanese (Han, Hiragana, Katakana): no whitespace word
+//   boundaries, so "single word" cannot be decided exactly. A
+//   whitespace-free run of at most MAX_CJK_WORD_CHARS characters is
+//   treated as one lookup unit; longer runs are phrases and return
+//   to the toolbar. 4 covers the vast majority of CJK headwords,
+//   including 4-character idioms.
+// - Anything else (internal whitespace, punctuation, mixed scripts)
+//   is not a single word.
+const MAX_CJK_WORD_CHARS = 4;
+
+const LATIN_WORD = /^[A-Za-z][A-Za-z'-]*$/;
+const HANGUL_WORD = /^\p{Script=Hangul}+$/u;
+const CJK_RUN = /^[\p{Script=Han}\p{Script=Hiragana}\p{Script=Katakana}ー]+$/u;
+
 function isSingleWord(text) {
-  return /^[A-Za-z][A-Za-z'-]*$/.test(text);
+  if (LATIN_WORD.test(text)) return true;
+  if (HANGUL_WORD.test(text)) return true;
+  return [...text].length <= MAX_CJK_WORD_CHARS && CJK_RUN.test(text);
 }
 
-module.exports = { isSingleWord };
+module.exports = { isSingleWord, MAX_CJK_WORD_CHARS };
