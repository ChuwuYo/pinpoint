diff --git a/src/word.js b/src/word.js
index 14e3674..6bb147b 100644
--- a/src/word.js
+++ b/src/word.js
@@ -1,8 +1,19 @@
 'use strict';
 
 // Selection/word logic lives in this module.
+
+// CJK text has no whitespace word boundaries, so the ASCII regex cannot
+// decide "single word" for it. Defer non-ASCII selections to ICU word
+// segmentation and accept only selections that are exactly one word-like
+// segment; anything ambiguous falls back to the toolbar.
+const wordSegmenter = new Intl.Segmenter(undefined, { granularity: 'word' });
+
 function isSingleWord(text) {
-  return /^[A-Za-z][A-Za-z'-]*$/.test(text);
+  if (/^[\x00-\x7F]*$/.test(text)) {
+    return /^[A-Za-z][A-Za-z'-]*$/.test(text);
+  }
+  const segments = [...wordSegmenter.segment(text)];
+  return segments.length === 1 && segments[0].isWordLike === true;
 }
 
 module.exports = { isSingleWord };
