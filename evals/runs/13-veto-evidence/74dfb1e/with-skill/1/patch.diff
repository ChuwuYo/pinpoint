diff --git a/src/word.js b/src/word.js
index 14e3674..288a6d7 100644
--- a/src/word.js
+++ b/src/word.js
@@ -1,8 +1,26 @@
 'use strict';
 
 // Selection/word logic lives in this module.
+
+// CJK text has no whitespace word boundaries, so "single word" cannot be
+// decided exactly. A selection is treated as a lookupable CJK word when it
+// is:
+//   - free of whitespace (whitespace marks a phrase or sentence),
+//   - entirely Han / Hiragana / Katakana / Hangul (mixed Latin falls
+//     through to the toolbar),
+//   - at most MAX_CJK_WORD_LENGTH code points. The cap stands in for the
+//     longest plausible dictionary headword: most CJK headwords are 1-2
+//     characters and 4 covers compounds and chengyu/yojijukugo. Longer
+//     genuine headwords (e.g. 5-mora kana words like ありがとう) degrade
+//     to the toolbar by design: a missed lookup on a rare long word is
+//     cheaper than firing metered popup lookups on phrases and sentences.
+const MAX_CJK_WORD_LENGTH = 4;
+const CJK_WORD_RE =
+  /^(?:\p{Script=Han}|\p{Script=Hiragana}|\p{Script=Katakana}|\p{Script=Hangul})+$/u;
+
 function isSingleWord(text) {
-  return /^[A-Za-z][A-Za-z'-]*$/.test(text);
+  if (/^[A-Za-z][A-Za-z'-]*$/.test(text)) return true;
+  return [...text].length <= MAX_CJK_WORD_LENGTH && CJK_WORD_RE.test(text);
 }
 
 module.exports = { isSingleWord };
