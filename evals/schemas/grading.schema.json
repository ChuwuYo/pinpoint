{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinpoint evaluation grading record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenario",
    "run",
    "evaluator",
    "items",
    "deterministic_checks"
  ],
  "properties": {
    "scenario": { "type": "string" },
    "run": { "type": "string" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "blinded"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["human", "model"] },
        "blinded": { "type": "boolean" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "critical", "score", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "critical": { "type": "boolean" },
          "score": { "type": "number", "enum": [0, 0.5, 1] },
          "evidence": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail", "unavailable"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "disagreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "resolution"],
      "properties": {
        "present": { "type": "boolean" },
        "resolution": { "type": "string" }
      }
    }
  }
}
